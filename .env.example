# Azure OpenAI — endpoint looks like https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names, NOT model names. These are chosen per Azure resource and
# frequently differ from the underlying model. Run `npm run smoke` to discover
# what your resource actually exposes.
MODEL_SCORE=gpt-4.1-mini
MODEL_DECOMPOSE=gpt-4.1
MODEL_CLASSIFY=o4-mini

# Classic PAT or fine-grained token with issues:write on the target repo.
# In Actions this is provided automatically as secrets.GITHUB_TOKEN.
GITHUB_TOKEN=
