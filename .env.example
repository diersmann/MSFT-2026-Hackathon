# Which backend to use: "openai" or "azure". Blank auto-detects (OpenAI wins if
# OPENAI_API_KEY is set).
MODEL_PROVIDER=openai

# --- Option A: OpenAI directly (simplest) -----------------------------------
OPENAI_API_KEY=
# Optional: any OpenAI-compatible gateway (OpenRouter, Groq, local Ollama).
OPENAI_BASE_URL=

# --- Option B: Azure OpenAI -------------------------------------------------
# Endpoint is the bare root, https://<resource>.openai.azure.com, with no path;
# pasting a full deployment target URI gives a 404 that reads like a bad key.
# Azure also grants per-model quota separately from billing, so a funded
# subscription can still deploy nothing.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# On OpenAI these are plain model names. On Azure they are *deployment* names,
# chosen per resource and often unlike the model. Run `npm run smoke` to see
# what your credentials actually reach.
MODEL_SCORE=gpt-4o-mini
MODEL_DECOMPOSE=gpt-4o
MODEL_CLASSIFY=gpt-4o

# Classic PAT or fine-grained token with issues:write on the target repo.
# In Actions this is provided automatically as secrets.GITHUB_TOKEN.
GITHUB_TOKEN=

# Which repo the dashboard and CLI act on. Point this at the playground repo so
# a demo never writes to the engine repo by accident.
DISPATCH_TARGET_REPO=sametd04/widgetworks-playground

# Reasoning models reject the temperature parameter, so they are called
# differently. Comma-separated; only needed if a name defeats the o-series
# heuristic in azure.ts (e.g. a deployment named "planner" that is really o4).
DISPATCH_REASONING_DEPLOYMENTS=
