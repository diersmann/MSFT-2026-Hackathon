# Azure OpenAI — endpoint looks like https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names, NOT model names. These are chosen per Azure resource and
# frequently differ from the underlying model. Run `npm run smoke` to discover
# what your resource actually exposes.
MODEL_SCORE=gpt-4.1-mini
MODEL_DECOMPOSE=gpt-4.1
MODEL_CLASSIFY=o4-mini

# Classic PAT or fine-grained token with issues:write on the target repo.
# In Actions this is provided automatically as secrets.GITHUB_TOKEN.
GITHUB_TOKEN=

# Which repo the dashboard and CLI act on. Point this at the playground repo so
# a demo never writes to the engine repo by accident.
DISPATCH_TARGET_REPO=diersmann/MSFT-2026-Hackathon

# Reasoning deployments reject the temperature parameter, so they are called
# differently. Comma-separated; only needed if a name defeats the o-series
# heuristic in azure.ts (e.g. a deployment named "planner" that is really o4).
DISPATCH_REASONING_DEPLOYMENTS=
